# ════════════════════════════════════════════════════════════════════════════
# ARGO NAVIS (SNM) — Variables para docker-compose-prod.yml
# Copiar como `.env` (en la raíz del repo, junto a docker-compose-prod.yml) y
# completar los valores reales. Docker Compose lo lee solo. NO subir el `.env`
# resultante al repo (el patrón `.env` en .gitignore ya lo cubre).
# ════════════════════════════════════════════════════════════════════════════

# ───── Base de datos (contenedor postgres_db) ─────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REEMPLAZAR_CON_CONTRASENA_SEGURA
POSTGRES_DB=argonavis

# ───── Aplicación ─────
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotar al menos cada 90 días. Cambiar invalida todas las sesiones activas.
# En producción el backend no arranca con menos de 32 caracteres ni con este valor.
SECRET_KEY=REEMPLAZAR_CON_CLAVE_GENERADA

# ───── LDAP / Active Directory ─────
LDAP_HOST=192.168.X.X
LDAP_BASE_DN=DC=ejemplo,DC=local
LDAP_BIND_USER=cuenta-servicio@ejemplo.local
LDAP_BIND_PASSWORD=REEMPLAZAR
# TLS con el AD (ver backend/.env.example). Para LDAPS: LDAP_USAR_SSL=true y LDAP_PORT=636.
LDAP_PORT=389
LDAP_USAR_SSL=false
LDAP_STARTTLS=false
# Ruta DENTRO del contenedor (montar el PEM de la CA con un volumen); vacío = CA del sistema.
LDAP_CA_CERT=

# ───── SMTP ─────
MAIL_HOST=correo.ejemplo.local
MAIL_FROM=no-reply@ejemplo.local

# ───── Autorizaciones Marítimas ─────
# Buzón de UCVMM que recibe el aviso de cada solicitud nueva o corregida (vacío = sin aviso)
CORREO_UCVMM=autorizacionmaritima@migracion.gob.pa

# ───── URL pública del servidor (CORS + enlaces en correos) ─────
APP_URL=http://IP-O-DOMINIO-DEL-SERVIDOR

# ───── Cuentas locales (sin AD) ─────
# true habilita las cuentas con contraseña propia, p. ej. para los usuarios de
# las agencias navieras (12+ caracteres con mayúscula, minúscula, número y
# carácter especial; bloqueo tras 5 intentos; cambio obligatorio al entrar).
# false = solo Active Directory.
PERMITIR_LOGIN_LOCAL=false

# ───── Freno del login del Active Directory (ver backend/.env.example) ─────
# Ajustar a la política de bloqueo del dominio: LOGIN_AD_MAX_FALLOS por debajo
# del umbral de bloqueo y LOGIN_AD_MINUTOS_ESPERA >= su ventana de restablecimiento.
LOGIN_AD_MAX_FALLOS=3
LOGIN_AD_MINUTOS_ESPERA=30
