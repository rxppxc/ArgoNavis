# ════════════════════════════════════════════════════════════════════════════
# ARGO NAVIS (SNM) — Variables para docker-compose-prod.yml
# Copiar como `.env` (en la raíz del repo, junto a docker-compose-prod.yml) y
# completar los valores reales. Docker Compose lo lee solo. NO subir el `.env`
# resultante al repo (el patrón `.env` en .gitignore ya lo cubre).
# ════════════════════════════════════════════════════════════════════════════

# ───── Base de datos (contenedor postgres_db) ─────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REEMPLAZAR_CON_CONTRASENA_SEGURA
POSTGRES_DB=argonavis
# Cuenta con la que entra la aplicación: lee y escribe filas, pero no crea ni cambia
# tablas y solo agrega a la bitácora. La crea el backend al arrancar. Generar con:
#   openssl rand -hex 24      (solo letras y números: va dentro de una URL)
POSTGRES_APP_PASSWORD=REEMPLAZAR_CON_OTRA_CONTRASENA
# POSTGRES_APP_USER=argonavis_app

# ───── PostgreSQL 18 (README → PostgreSQL 18) ─────
# En un servidor nuevo, antes del primer arranque: quita el «# » de las dos líneas. Van juntas:
# la 18 guarda los datos en otra carpeta y no abre los de la 15. Sin ellas, la 15, que se
# queda sin soporte en noviembre de 2027.
# POSTGRES_IMAGEN=postgres:18.7-alpine3.24
# POSTGRES_VOLUMEN=postgres_18:/var/lib/postgresql

# ───── Aplicación ─────
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotar al menos cada 90 días. Cambiar invalida todas las sesiones activas.
# En producción el backend no arranca con menos de 32 caracteres ni con este valor.
SECRET_KEY=REEMPLAZAR_CON_CLAVE_GENERADA

# ───── Logs ─────
# Van a la salida de Docker (docker compose -f docker-compose-prod.yml logs backend),
# que los rota, y a un archivo por día en un volumen, que no se borra al desplegar.
# DEBUG | INFO | WARNING | ERROR
LOG_NIVEL=INFO
# Días que se guardan los archivos: los del backend y los accesos de nginx.
LOG_DIAS=90

# ───── Vigilancia (vigilar.py) ─────
# A quién avisar cuando algo falla en el servidor, separados por comas. Vacío = a nadie.
# Después de ponerlo, pruébalo: sudo python3 -I vigilar.py --probar
CORREO_ALERTAS=

# ───── Procesos de la API ─────
# Con uno solo, una petición que ocupa la CPU (un PDF, bcrypt) frena a las demás.
# Cada proceso abre hasta 15 conexiones a PostgreSQL (BD_POOL + BD_POOL_EXTRA,
# ver backend/.env.example) y el servidor admite 100.
UVICORN_WORKERS=2

# ───── Límites de cada contenedor (README → Producción → Recursos) ─────
# Si uno se pasa de su memoria, Docker corta un proceso de ese contenedor (y se
# levanta solo), en vez de que el kernel mate a PostgreSQL. Ajústalos a la VM:
# medido con 100 usuarios, el backend usa ~410 MB con 2 procesos (~200 MB más por
# cada proceso extra). BACKEND_CPUS: tantos núcleos como UVICORN_WORKERS si la VM
# tiene más; en una VM de 2 núcleos, 1.5 (que a PostgreSQL y nginx les quede CPU).
# verificar-despliegue.sh muestra el uso de cada uno contra su límite.
POSTGRES_MEMORIA=1g
BACKEND_MEMORIA=1g
BACKEND_CPUS=2
FRONTEND_MEMORIA=256m

# ───── Red interna de la base de datos ─────
# La que comparten solo el backend y PostgreSQL. Cámbiala si coincide con una red del
# SNM o de la VPN (un /28 alcanza): el servidor no alcanzaría los equipos de esa red.
# RED_DATOS=172.31.255.240/28

# ───── LDAP / Active Directory ─────
LDAP_HOST=192.168.X.X
LDAP_BASE_DN=DC=ejemplo,DC=local
LDAP_BIND_USER=cuenta-servicio@ejemplo.local
LDAP_BIND_PASSWORD=REEMPLAZAR
# TLS con el AD (ver backend/.env.example). Para LDAPS: LDAP_USAR_SSL=true y LDAP_PORT=636.
LDAP_PORT=389
LDAP_USAR_SSL=false
LDAP_STARTTLS=false
# La CA interna que firma el certificado del AD: se pone el PEM en certificados/ca del
# servidor y aquí va LDAP_CA_CERT=/certificados/ca/<archivo>.pem. Vacío = las CA del sistema.
LDAP_CA_CERT=

# ───── SMTP ─────
MAIL_HOST=correo.ejemplo.local
MAIL_FROM=no-reply@ejemplo.local
# Usuario y contraseña, si el servidor los pide (vacíos = sin autenticación).
MAIL_USERNAME=
MAIL_PASSWORD=
# TLS (ver backend/.env.example). Con usuario y contraseña, actívalo: sin TLS viajan en claro.
# STARTTLS: MAIL_STARTTLS=true y MAIL_PORT=587 (o 25) · SMTPS: MAIL_USAR_SSL=true y MAIL_PORT=465.
MAIL_PORT=25
MAIL_STARTTLS=false
MAIL_USAR_SSL=false
# Como LDAP_CA_CERT: /certificados/ca/<archivo>.pem. Vacío = las CA del sistema.
MAIL_CA_CERT=

# ───── Autorizaciones Marítimas ─────
# Buzón de UCVMM que recibe el aviso de cada solicitud nueva o corregida (vacío = sin aviso)
CORREO_UCVMM=autorizacionmaritima@migracion.gob.pa
# Costo migratorio (B/.) de una solicitud aprobada fuera del horario laboral (lunes a viernes,
# de 07:00 a 15:00). Se guarda al aprobar: cambiarlo no toca lo ya aprobado. 0 = sin costo.
COSTO_FUERA_DE_HORARIO=20.00

# ───── URL pública del servidor (CORS + enlaces en correos) ─────
APP_URL=http://IP-O-DOMINIO-DEL-SERVIDOR
# HTTPS (README → «HTTPS»): con el certificado en certificados/https (argonavis.crt y
# argonavis.key), true y APP_URL=https://<el nombre del certificado>. El 80 solo redirige.
USAR_HTTPS=false
# Dirección pública de la verificación del QR (sin la ruta), cuando la DTI la publique
# en internet con HTTPS (README → «Verificación pública del QR»). Vacía = APP_URL, y
# el QR del PDF solo se puede escanear dentro de la red del SNM.
URL_VERIFICACION_PUBLICA=

# ───── Cuentas locales (sin AD) ─────
# true habilita las cuentas con contraseña propia, p. ej. para los usuarios de
# las agencias navieras (12+ caracteres con mayúscula, minúscula, número y
# carácter especial; bloqueo tras 5 intentos; cambio obligatorio al entrar).
# false = solo Active Directory.
PERMITIR_LOGIN_LOCAL=false

# ───── Freno del login del Active Directory (ver backend/.env.example) ─────
# Ajustar a la política de bloqueo del dominio: LOGIN_AD_MAX_FALLOS por debajo
# del umbral de bloqueo y LOGIN_AD_MINUTOS_ESPERA >= su ventana de restablecimiento.
LOGIN_AD_MAX_FALLOS=3
LOGIN_AD_MINUTOS_ESPERA=30
