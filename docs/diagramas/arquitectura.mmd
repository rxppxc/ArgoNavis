flowchart TB
    subgraph USU["Usuarios"]
        direction LR
        VE["Verificador<br/>(escanea el QR del PDF)"]
        AG["Agencias navieras<br/>(por la VPN)"]
        FU["Funcionarios del SNM<br/>UCVMM · puestos · supervisión · administración"]
    end
    subgraph SRV["Servidor de ARGO NAVIS (Docker)"]
        direction LR
        NG["nginx<br/>SPA React + proxy /api<br/>HTTP o HTTPS · cabeceras de seguridad"]
        API["API FastAPI + Uvicorn<br/>reglas · PDF · correos<br/>tareas de fondo"]
        BD[("PostgreSQL 15 o 18<br/>datos, historial y bitácora")]
        DOC[("Volumen de documentos<br/>una carpeta por solicitud")]
        VIG["vigilar.py y backup.sh<br/>(cron del servidor, fuera de Docker)<br/>revisan y respaldan"]
    end
    AD["Active Directory del SNM<br/>LDAP / LDAPS"]
    SMTP["Servidor de correo del SNM<br/>SMTP / STARTTLS"]
    SIM["SIMPLUS · fuera de ARGO NAVIS<br/>(UCVMM y el puesto lo consultan a mano)"]
    VE -->|"/verificar/{código} y su PDF"| NG
    AG -->|HTTP o HTTPS| NG
    FU -->|HTTP o HTTPS| NG
    NG -->|/api| API
    API --> BD
    API --> DOC
    API -->|autenticación| AD
    API -->|avisos| SMTP
    VIG -.->|alertas| SMTP
    FU -.->|consulta manual| SIM
