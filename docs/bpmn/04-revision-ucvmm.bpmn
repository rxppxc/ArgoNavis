<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_RevisionUCVMM" targetNamespace="https://argonavis.migracion.gob.pa/bpmn" exporter="ARGO NAVIS" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracion_RevisionUCVMM">
    <bpmn:participant id="Pool_RevisionUCVMM" name="ARGO NAVIS · Revisión de UCVMM (detalle)" processRef="Proceso_RevisionUCVMM" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_RevisionUCVMM" name="Revisión de UCVMM" isExecutable="false">
    <bpmn:laneSet id="Carriles_Proceso_RevisionUCVMM">
      <bpmn:lane id="C_UCVMM" name="UCVMM · Sector Pacífico">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Simplus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marcar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GCorregir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Corregir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GUne1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GImpedimento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Operaciones</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GUne2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decidir</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="C_Sistema" name="ARGO NAVIS (sistema)">
        <bpmn:flowNodeRef>Expediente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GConflicto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinConflicto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RegCorreccion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Devolver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinDevuelta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Denegar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinDenegada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Aprobar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinAprobada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ErrAprobar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinNoAprobable</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Solicitud en la cola de revisión">
      <bpmn:outgoing>Flujo_Inicio_Expediente</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Inicio" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Expediente" name="Mostrar el expediente y comprobar la separación de funciones">
      <bpmn:incoming>Flujo_Inicio_Expediente</bpmn:incoming>
      <bpmn:outgoing>Flujo_Expediente_GConflicto</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GConflicto" name="¿La creó o es de su agencia?">
      <bpmn:incoming>Flujo_Expediente_GConflicto</bpmn:incoming>
      <bpmn:outgoing>Flujo_GConflicto_FinConflicto</bpmn:outgoing>
      <bpmn:outgoing>Flujo_GConflicto_Revisar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="FinConflicto" name="La revisa otro funcionario">
      <bpmn:incoming>Flujo_GConflicto_FinConflicto</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Revisar" name="Revisar datos y documentos del expediente">
      <bpmn:incoming>Flujo_GConflicto_Revisar</bpmn:incoming>
      <bpmn:outgoing>Flujo_Revisar_Simplus</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Simplus" name="Consultar a cada tripulante en SIMPLUS">
      <bpmn:incoming>Flujo_Revisar_Simplus</bpmn:incoming>
      <bpmn:outgoing>Flujo_Simplus_Marcar</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Marcar" name="Marcar Sin o Con impedimento por tripulante y guardar">
      <bpmn:incoming>Flujo_Simplus_Marcar</bpmn:incoming>
      <bpmn:outgoing>Flujo_Marcar_Registrar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Registrar" name="Registrar la verificación en el historial y la bitácora">
      <bpmn:incoming>Flujo_Marcar_Registrar</bpmn:incoming>
      <bpmn:outgoing>Flujo_Registrar_GCorregir</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GCorregir" name="¿Hay que corregir algún resultado?">
      <bpmn:incoming>Flujo_Registrar_GCorregir</bpmn:incoming>
      <bpmn:outgoing>Flujo_GCorregir_Corregir</bpmn:outgoing>
      <bpmn:outgoing>Flujo_GCorregir_GUne1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Corregir" name="Corregir los resultados e indicar el motivo">
      <bpmn:incoming>Flujo_GCorregir_Corregir</bpmn:incoming>
      <bpmn:outgoing>Flujo_Corregir_RegCorreccion</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="RegCorreccion" name="Registrar la corrección: qué cambió y por qué">
      <bpmn:incoming>Flujo_Corregir_RegCorreccion</bpmn:incoming>
      <bpmn:outgoing>Flujo_RegCorreccion_GUne1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GUne1" name="">
      <bpmn:incoming>Flujo_GCorregir_GUne1</bpmn:incoming>
      <bpmn:incoming>Flujo_RegCorreccion_GUne1</bpmn:incoming>
      <bpmn:outgoing>Flujo_GUne1_GImpedimento</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GImpedimento" name="¿Algún tripulante con impedimento?">
      <bpmn:incoming>Flujo_GUne1_GImpedimento</bpmn:incoming>
      <bpmn:outgoing>Flujo_GImpedimento_Operaciones</bpmn:outgoing>
      <bpmn:outgoing>Flujo_GImpedimento_GUne2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Operaciones" name="Informar a Operaciones (fuera de ARGO NAVIS)">
      <bpmn:incoming>Flujo_GImpedimento_Operaciones</bpmn:incoming>
      <bpmn:outgoing>Flujo_Operaciones_GUne2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GUne2" name="">
      <bpmn:incoming>Flujo_Operaciones_GUne2</bpmn:incoming>
      <bpmn:incoming>Flujo_GImpedimento_GUne2</bpmn:incoming>
      <bpmn:outgoing>Flujo_GUne2_Decidir</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Decidir" name="Decidir en el modal (aprobar, devolver o denegar) con su texto">
      <bpmn:incoming>Flujo_GUne2_Decidir</bpmn:incoming>
      <bpmn:outgoing>Flujo_Decidir_GDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GDecision" name="¿Qué decidió?">
      <bpmn:incoming>Flujo_Decidir_GDecision</bpmn:incoming>
      <bpmn:outgoing>Flujo_GDecision_Devolver</bpmn:outgoing>
      <bpmn:outgoing>Flujo_GDecision_Denegar</bpmn:outgoing>
      <bpmn:outgoing>Flujo_GDecision_Aprobar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Devolver" name="Devolver: plazo de corrección y aviso a la agencia">
      <bpmn:incoming>Flujo_GDecision_Devolver</bpmn:incoming>
      <bpmn:outgoing>Flujo_Devolver_FinDevuelta</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="FinDevuelta" name="Devuelta a corrección">
      <bpmn:incoming>Flujo_Devolver_FinDevuelta</bpmn:incoming>
      <bpmn:messageEventDefinition id="Def_FinDevuelta" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="Denegar" name="Denegar (estado final) y avisar a la agencia">
      <bpmn:incoming>Flujo_GDecision_Denegar</bpmn:incoming>
      <bpmn:outgoing>Flujo_Denegar_FinDenegada</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="FinDenegada" name="Denegada">
      <bpmn:incoming>Flujo_Denegar_FinDenegada</bpmn:incoming>
      <bpmn:messageEventDefinition id="Def_FinDenegada" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="Aprobar" name="Aprobar: vigencia, código del QR y aviso a la agencia y al puesto">
      <bpmn:incoming>Flujo_GDecision_Aprobar</bpmn:incoming>
      <bpmn:outgoing>Flujo_Aprobar_FinAprobada</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="FinAprobada" name="Aprobada">
      <bpmn:incoming>Flujo_Aprobar_FinAprobada</bpmn:incoming>
      <bpmn:messageEventDefinition id="Def_FinAprobada" />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="ErrAprobar" name="No cumple" attachedToRef="Aprobar">
      <bpmn:outgoing>Flujo_ErrAprobar_FinNoAprobable</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Def_ErrAprobar" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="FinNoAprobable" name="No se aprueba: falta la verificación o ya pasó la fecha (hay que devolverla)">
      <bpmn:incoming>Flujo_ErrAprobar_FinNoAprobable</bpmn:incoming>
      <bpmn:errorEventDefinition id="Def_FinNoAprobable" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_Inicio_Expediente" sourceRef="Inicio" targetRef="Expediente" />
    <bpmn:sequenceFlow id="Flujo_Expediente_GConflicto" sourceRef="Expediente" targetRef="GConflicto" />
    <bpmn:sequenceFlow id="Flujo_GConflicto_FinConflicto" name="Sí" sourceRef="GConflicto" targetRef="FinConflicto" />
    <bpmn:sequenceFlow id="Flujo_GConflicto_Revisar" name="No" sourceRef="GConflicto" targetRef="Revisar" />
    <bpmn:sequenceFlow id="Flujo_Revisar_Simplus" sourceRef="Revisar" targetRef="Simplus" />
    <bpmn:sequenceFlow id="Flujo_Simplus_Marcar" sourceRef="Simplus" targetRef="Marcar" />
    <bpmn:sequenceFlow id="Flujo_Marcar_Registrar" sourceRef="Marcar" targetRef="Registrar" />
    <bpmn:sequenceFlow id="Flujo_Registrar_GCorregir" sourceRef="Registrar" targetRef="GCorregir" />
    <bpmn:sequenceFlow id="Flujo_GCorregir_Corregir" name="Sí" sourceRef="GCorregir" targetRef="Corregir" />
    <bpmn:sequenceFlow id="Flujo_Corregir_RegCorreccion" sourceRef="Corregir" targetRef="RegCorreccion" />
    <bpmn:sequenceFlow id="Flujo_GCorregir_GUne1" name="No" sourceRef="GCorregir" targetRef="GUne1" />
    <bpmn:sequenceFlow id="Flujo_RegCorreccion_GUne1" sourceRef="RegCorreccion" targetRef="GUne1" />
    <bpmn:sequenceFlow id="Flujo_GUne1_GImpedimento" sourceRef="GUne1" targetRef="GImpedimento" />
    <bpmn:sequenceFlow id="Flujo_GImpedimento_Operaciones" name="Sí" sourceRef="GImpedimento" targetRef="Operaciones" />
    <bpmn:sequenceFlow id="Flujo_Operaciones_GUne2" sourceRef="Operaciones" targetRef="GUne2" />
    <bpmn:sequenceFlow id="Flujo_GImpedimento_GUne2" name="No" sourceRef="GImpedimento" targetRef="GUne2" />
    <bpmn:sequenceFlow id="Flujo_GUne2_Decidir" sourceRef="GUne2" targetRef="Decidir" />
    <bpmn:sequenceFlow id="Flujo_Decidir_GDecision" sourceRef="Decidir" targetRef="GDecision" />
    <bpmn:sequenceFlow id="Flujo_GDecision_Devolver" name="Devolver" sourceRef="GDecision" targetRef="Devolver" />
    <bpmn:sequenceFlow id="Flujo_Devolver_FinDevuelta" sourceRef="Devolver" targetRef="FinDevuelta" />
    <bpmn:sequenceFlow id="Flujo_GDecision_Denegar" name="Denegar" sourceRef="GDecision" targetRef="Denegar" />
    <bpmn:sequenceFlow id="Flujo_Denegar_FinDenegada" sourceRef="Denegar" targetRef="FinDenegada" />
    <bpmn:sequenceFlow id="Flujo_GDecision_Aprobar" name="Aprobar" sourceRef="GDecision" targetRef="Aprobar" />
    <bpmn:sequenceFlow id="Flujo_Aprobar_FinAprobada" sourceRef="Aprobar" targetRef="FinAprobada" />
    <bpmn:sequenceFlow id="Flujo_ErrAprobar_FinNoAprobable" sourceRef="ErrAprobar" targetRef="FinNoAprobable" />
    <bpmn:textAnnotation id="N_Separacion"><bpmn:text>Separación de funciones: nadie revisa lo que creó ni lo de su agencia (tampoco el Administrador).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_N_Separacion" sourceRef="Expediente" targetRef="N_Separacion" />
    <bpmn:textAnnotation id="N_Simplus"><bpmn:text>Fuera de ARGO NAVIS: no hay integración con SIMPLUS; el resultado se marca a mano.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_N_Simplus" sourceRef="Simplus" targetRef="N_Simplus" />
    <bpmn:textAnnotation id="N_Registrar"><bpmn:text>Obligatoria para aprobar: cada tripulante, una vez.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_N_Registrar" sourceRef="Registrar" targetRef="N_Registrar" />
    <bpmn:textAnnotation id="N_Correccion"><bpmn:text>Corrección: exige motivo (5 caracteres o más) y algún cambio; el historial guarda qué cambió y por qué.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_N_Correccion" sourceRef="RegCorreccion" targetRef="N_Correccion" />
    <bpmn:textAnnotation id="N_Impedimento"><bpmn:text>Con impedimento igual se puede aprobar: el modal de aprobar pide confirmar que se informó a Operaciones.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_N_Impedimento" sourceRef="GImpedimento" targetRef="N_Impedimento" />
    <bpmn:textAnnotation id="N_Concurrencia"><bpmn:text>Si otro funcionario decidió antes, se rechaza (bloqueo de la fila).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_N_Concurrencia" sourceRef="Decidir" targetRef="N_Concurrencia" />
    <bpmn:textAnnotation id="N_Plazo"><bpmn:text>Plazo: PLAZO_CORRECCION_DIAS (hoy, 2 días).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_N_Plazo" sourceRef="Devolver" targetRef="N_Plazo" />
    <bpmn:textAnnotation id="N_Vigencia"><bpmn:text>Vigente hasta el fin del día de la operación + 1 día (hora de Panamá). Genera el código del QR del PDF.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_N_Vigencia" sourceRef="Aprobar" targetRef="N_Vigencia" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_RevisionUCVMM">
    <bpmndi:BPMNPlane id="Plano_RevisionUCVMM" bpmnElement="Colaboracion_RevisionUCVMM">
      <bpmndi:BPMNShape id="Pool_RevisionUCVMM_di" bpmnElement="Pool_RevisionUCVMM" isHorizontal="true"><dc:Bounds x="100" y="40" width="2420" height="740" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_UCVMM_di" bpmnElement="C_UCVMM" isHorizontal="true"><dc:Bounds x="130" y="40" width="2390" height="320" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_Sistema_di" bpmnElement="C_Sistema" isHorizontal="true"><dc:Bounds x="130" y="360" width="2390" height="420" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inicio_di" bpmnElement="Inicio"><dc:Bounds x="184" y="182.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="166" y="136" width="74" height="44" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Expediente_di" bpmnElement="Expediente"><dc:Bounds x="240" y="525.0" width="140" height="90" /></bpmndi:BPMNShape>
