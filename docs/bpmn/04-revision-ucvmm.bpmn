      <bpmndi:BPMNShape id="FinConflicto_di" bpmnElement="FinConflicto"><dc:Bounds x="520" y="672.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="478.0" y="712.0" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Revisar_di" bpmnElement="Revisar"><dc:Bounds x="520" y="155.0" width="140" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Simplus_di" bpmnElement="Simplus"><dc:Bounds x="690" y="155.0" width="140" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Marcar_di" bpmnElement="Marcar"><dc:Bounds x="860" y="155.0" width="140" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Registrar_di" bpmnElement="Registrar"><dc:Bounds x="860" y="525.0" width="140" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GCorregir_di" bpmnElement="GCorregir" isMarkerVisible="true"><dc:Bounds x="1050" y="175.0" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1010" y="128" width="125" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Corregir_di" bpmnElement="Corregir"><dc:Bounds x="1120" y="260.0" width="140" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RegCorreccion_di" bpmnElement="RegCorreccion"><dc:Bounds x="1120" y="405.0" width="140" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GUne1_di" bpmnElement="GUne1" isMarkerVisible="true"><dc:Bounds x="1310" y="175.0" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GImpedimento_di" bpmnElement="GImpedimento" isMarkerVisible="true"><dc:Bounds x="1400" y="175.0" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1452" y="144" width="120" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Operaciones_di" bpmnElement="Operaciones"><dc:Bounds x="1480" y="50.0" width="140" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GUne2_di" bpmnElement="GUne2" isMarkerVisible="true"><dc:Bounds x="1660" y="175.0" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Decidir_di" bpmnElement="Decidir"><dc:Bounds x="1750" y="155.0" width="140" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDecision_di" bpmnElement="GDecision" isMarkerVisible="true"><dc:Bounds x="1950" y="545.0" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1852" y="598" width="96" height="34" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Devolver_di" bpmnElement="Devolver"><dc:Bounds x="2040" y="405.0" width="140" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FinDevuelta_di" bpmnElement="FinDevuelta"><dc:Bounds x="2230" y="432.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2188.0" y="472.0" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Denegar_di" bpmnElement="Denegar"><dc:Bounds x="2040" y="645.0" width="140" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FinDenegada_di" bpmnElement="FinDenegada"><dc:Bounds x="2230" y="672.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2188.0" y="712.0" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Aprobar_di" bpmnElement="Aprobar"><dc:Bounds x="2230" y="525.0" width="140" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FinAprobada_di" bpmnElement="FinAprobada"><dc:Bounds x="2420" y="552.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2378.0" y="592.0" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ErrAprobar_di" bpmnElement="ErrAprobar"><dc:Bounds x="2282.0" y="597.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2222" y="618" width="56" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FinNoAprobable_di" bpmnElement="FinNoAprobable"><dc:Bounds x="2400" y="672.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2348" y="712" width="140" height="56" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Separacion_di" bpmnElement="N_Separacion"><dc:Bounds x="180" y="655" width="290" height="48" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Simplus_di" bpmnElement="N_Simplus"><dc:Bounds x="600" y="52" width="330" height="40" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Registrar_di" bpmnElement="N_Registrar"><dc:Bounds x="790" y="660" width="280" height="34" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Correccion_di" bpmnElement="N_Correccion"><dc:Bounds x="1080" y="540" width="330" height="56" /></bpmndi:BPMNShape>
