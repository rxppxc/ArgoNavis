<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_MapaGeneral" targetNamespace="https://argonavis.migracion.gob.pa/bpmn" exporter="ARGO NAVIS" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracion_MapaGeneral">
    <bpmn:participant id="Pool_MapaGeneral" name="ARGO NAVIS · Mapa general de procesos (Autorizaciones Marítimas)" processRef="Proceso_MapaGeneral" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_MapaGeneral" name="Mapa general de procesos" isExecutable="false">
    <bpmn:laneSet id="Carriles_Proceso_MapaGeneral">
      <bpmn:lane id="C_Agencia" name="Agencia naviera">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="C_UCVMM" name="UCVMM · Sector Pacífico">
        <bpmn:flowNodeRef>P03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinDenegada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="C_Puesto" name="Puesto de control">
        <bpmn:flowNodeRef>P05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinFinalizada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="C_Sistema" name="ARGO NAVIS (sistema)">
        <bpmn:flowNodeRef>IniVenc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinVenc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IniQR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinQR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IniAviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinAviso</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="C_Admin" name="Administración">
        <bpmn:flowNodeRef>IniAdmin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinAdmin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Se necesita una autorización marítima">
      <bpmn:outgoing>Flujo_Inicio_P01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="P01" name="P01 · Acceso al sistema">
      <bpmn:incoming>Flujo_Inicio_P01</bpmn:incoming>
      <bpmn:outgoing>Flujo_P01_P02</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="P02" name="P02 · Registrar y enviar la solicitud">
      <bpmn:incoming>Flujo_P01_P02</bpmn:incoming>
      <bpmn:outgoing>Flujo_P02_P03</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="P03" name="P03 · Revisar y decidir">
      <bpmn:incoming>Flujo_P02_P03</bpmn:incoming>
      <bpmn:incoming>Flujo_P04_P03</bpmn:incoming>
      <bpmn:outgoing>Flujo_P03_GDecision</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="GDecision" name="¿Qué decidió UCVMM?">
      <bpmn:incoming>Flujo_P03_GDecision</bpmn:incoming>
      <bpmn:outgoing>Flujo_GDecision_P04</bpmn:outgoing>
      <bpmn:outgoing>Flujo_GDecision_P05</bpmn:outgoing>
      <bpmn:outgoing>Flujo_GDecision_FinDenegada</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="FinDenegada" name="Solicitud denegada">
      <bpmn:incoming>Flujo_GDecision_FinDenegada</bpmn:incoming>
      <bpmn:messageEventDefinition id="Def_FinDenegada" />
    </bpmn:endEvent>
    <bpmn:subProcess id="P04" name="P04 · Corregir la solicitud devuelta">
      <bpmn:incoming>Flujo_GDecision_P04</bpmn:incoming>
      <bpmn:outgoing>Flujo_P04_P03</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="P05" name="P05 · Finalizar en el puesto de control">
      <bpmn:incoming>Flujo_GDecision_P05</bpmn:incoming>
      <bpmn:outgoing>Flujo_P05_FinFinalizada</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="FinFinalizada" name="Finalizada">
      <bpmn:incoming>Flujo_P05_FinFinalizada</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="IniVenc" name="Cada 15 minutos">
      <bpmn:outgoing>Flujo_IniVenc_P06</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_IniVenc" />
    </bpmn:startEvent>
    <bpmn:subProcess id="P06" name="P06 · Vencimientos automáticos">
      <bpmn:incoming>Flujo_IniVenc_P06</bpmn:incoming>
      <bpmn:outgoing>Flujo_P06_FinVenc</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="FinVenc" name="Vencidas expiradas">
      <bpmn:incoming>Flujo_P06_FinVenc</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="IniQR" name="Se escanea el código QR">
      <bpmn:outgoing>Flujo_IniQR_P07</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_IniQR" />
    </bpmn:startEvent>
    <bpmn:subProcess id="P07" name="P07 · Verificación pública (QR)">
      <bpmn:incoming>Flujo_IniQR_P07</bpmn:incoming>
      <bpmn:outgoing>Flujo_P07_FinQR</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="FinQR" name="Respuesta al verificador">
      <bpmn:incoming>Flujo_P07_FinQR</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="IniAviso" name="Ocurre un paso del flujo">
      <bpmn:outgoing>Flujo_IniAviso_P08</bpmn:outgoing>
      <bpmn:signalEventDefinition id="Def_IniAviso" />
    </bpmn:startEvent>
    <bpmn:subProcess id="P08" name="P08 · Avisos por correo">
      <bpmn:incoming>Flujo_IniAviso_P08</bpmn:incoming>
      <bpmn:outgoing>Flujo_P08_FinAviso</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="FinAviso" name="Avisos enviados">
      <bpmn:incoming>Flujo_P08_FinAviso</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="IniAdmin" name="Puesta en marcha o mantenimiento">
      <bpmn:outgoing>Flujo_IniAdmin_P09</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="P09" name="P09 · Administración funcional">
      <bpmn:incoming>Flujo_IniAdmin_P09</bpmn:incoming>
      <bpmn:outgoing>Flujo_P09_P10</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="P10" name="P10 · Administración técnica">
      <bpmn:incoming>Flujo_P09_P10</bpmn:incoming>
      <bpmn:outgoing>Flujo_P10_FinAdmin</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="FinAdmin" name="Catálogos y cuentas al día">
      <bpmn:incoming>Flujo_P10_FinAdmin</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_Inicio_P01" sourceRef="Inicio" targetRef="P01" />
    <bpmn:sequenceFlow id="Flujo_P01_P02" sourceRef="P01" targetRef="P02" />
    <bpmn:sequenceFlow id="Flujo_P02_P03" sourceRef="P02" targetRef="P03" />
    <bpmn:sequenceFlow id="Flujo_P03_GDecision" sourceRef="P03" targetRef="GDecision" />
    <bpmn:sequenceFlow id="Flujo_GDecision_P04" name="Devuelta" sourceRef="GDecision" targetRef="P04" />
    <bpmn:sequenceFlow id="Flujo_GDecision_P05" name="Aprobada" sourceRef="GDecision" targetRef="P05" />
    <bpmn:sequenceFlow id="Flujo_GDecision_FinDenegada" name="Denegada" sourceRef="GDecision" targetRef="FinDenegada" />
    <bpmn:sequenceFlow id="Flujo_P04_P03" name="Reenvía la solicitud corregida" sourceRef="P04" targetRef="P03" />
    <bpmn:sequenceFlow id="Flujo_P05_FinFinalizada" sourceRef="P05" targetRef="FinFinalizada" />
    <bpmn:sequenceFlow id="Flujo_IniVenc_P06" sourceRef="IniVenc" targetRef="P06" />
    <bpmn:sequenceFlow id="Flujo_P06_FinVenc" sourceRef="P06" targetRef="FinVenc" />
    <bpmn:sequenceFlow id="Flujo_IniQR_P07" sourceRef="IniQR" targetRef="P07" />
    <bpmn:sequenceFlow id="Flujo_P07_FinQR" sourceRef="P07" targetRef="FinQR" />
    <bpmn:sequenceFlow id="Flujo_IniAviso_P08" sourceRef="IniAviso" targetRef="P08" />
    <bpmn:sequenceFlow id="Flujo_P08_FinAviso" sourceRef="P08" targetRef="FinAviso" />
    <bpmn:sequenceFlow id="Flujo_IniAdmin_P09" sourceRef="IniAdmin" targetRef="P09" />
    <bpmn:sequenceFlow id="Flujo_P09_P10" sourceRef="P09" targetRef="P10" />
    <bpmn:sequenceFlow id="Flujo_P10_FinAdmin" sourceRef="P10" targetRef="FinAdmin" />
    <bpmn:textAnnotation id="N_P01"><bpmn:text>Lo usan todos los actores (cuenta del Active Directory o cuenta local).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_N_P01" sourceRef="P01" targetRef="N_P01" />
    <bpmn:textAnnotation id="N_P04"><bpmn:text>Si vence el plazo de corrección, P06 la expira.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_N_P04" sourceRef="P04" targetRef="N_P04" />
    <bpmn:textAnnotation id="N_P05"><bpmn:text>Si vence la vigencia sin finalizarse, P06 la expira.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_N_P05" sourceRef="P05" targetRef="N_P05" />
    <bpmn:textAnnotation id="N_P08"><bpmn:text>Nueva o corregida: a UCVMM. Aprobada: a la agencia y al puesto. Devuelta, denegada o expirada: a la agencia.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N_Admin"><bpmn:text>Procesos de soporte (Administrador y SysAdmin): habilitan cuentas, agencias, puestos y nacionalidades restringidas.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
