<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_Autorizacion" targetNamespace="https://argonavis.migracion.gob.pa/bpmn" exporter="ARGO NAVIS" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracion_Autorizacion">
    <bpmn:participant id="Pool_NAVIS" name="ARGO NAVIS · Autorizaciones Marítimas (SNM)" processRef="Proceso_Autorizacion" />
    <bpmn:participant id="Pool_Verificador" name="Autoridad o tercero que verifica" processRef="Proceso_Verificacion" />
    <bpmn:messageFlow id="Mensaje_ConsultaQR" sourceRef="EscanearQR" targetRef="ConsultaQR" />
    <bpmn:messageFlow id="Mensaje_RespuestaQR" sourceRef="RespuestaQR" targetRef="ConfirmarValidez" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_Autorizacion" name="Autorización marítima (UCVMM)" isExecutable="false">
    <bpmn:documentation>Agencia naviera → UCVMM → puesto de control, según el documento de UCVMM «Documentación requerida para las autorizaciones marítimas» y el Formulario No. 3.</bpmn:documentation>
    <bpmn:laneSet id="Carriles_Proceso_Autorizacion">
      <bpmn:lane id="Carril_Agencia" name="Agencia naviera">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IniciarSesion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LlenarSolicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AdjuntarDocumentos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UnirEnvio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Corregir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VencePlazoCorreccion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExpiradaSinCorregir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Descargar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AgenciaConAutorizacion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_NAVIS" name="ARGO NAVIS (sistema)">
        <bpmn:flowNodeRef>Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CumpleTodo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AvisarUCVMM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AvisoDevolucion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GenerarAutorizacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AvisoAprobacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EnParalelo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConsultaQR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MostrarEstado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RespuestaQR</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_UCVMM" name="UCVMM · Sector Pacífico">
        <bpmn:flowNodeRef>Revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Impedimentos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Denegada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_Puesto" name="Puesto de control">
        <bpmn:flowNodeRef>Finalizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VenceFinalizacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Finalizada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExpiradaSinFinalizar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Se necesita una autorización marítima">
      <bpmn:outgoing>Flujo_Inicio_IniciarSesion</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="IniciarSesion" name="Iniciar sesión" calledElement="Proceso_Acceso">
      <bpmn:documentation>Ver el diagrama «Acceso a ARGO NAVIS».</bpmn:documentation>
      <bpmn:incoming>Flujo_Inicio_IniciarSesion</bpmn:incoming>
      <bpmn:outgoing>Flujo_IniciarSesion_LlenarSolicitud</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="LlenarSolicitud" name="Llenar o corregir la solicitud (Form. 3)">
      <bpmn:documentation>Trámite, buque (IMO), puesto de control, fecha de la operación y tripulantes.</bpmn:documentation>
      <bpmn:incoming>Flujo_IniciarSesion_LlenarSolicitud</bpmn:incoming>
      <bpmn:incoming>Flujo_CumpleTodo_LlenarSolicitud</bpmn:incoming>
      <bpmn:outgoing>Flujo_LlenarSolicitud_AdjuntarDocumentos</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="AdjuntarDocumentos" name="Adjuntar los documentos del checklist">
      <bpmn:documentation>PDF, Word o Excel. Por tripulante o por solicitud según el trámite; hasta 20 adicionales.</bpmn:documentation>
      <bpmn:incoming>Flujo_LlenarSolicitud_AdjuntarDocumentos</bpmn:incoming>
      <bpmn:outgoing>Flujo_AdjuntarDocumentos_UnirEnvio</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="UnirEnvio">
      <bpmn:incoming>Flujo_AdjuntarDocumentos_UnirEnvio</bpmn:incoming>
      <bpmn:incoming>Flujo_Corregir_UnirEnvio</bpmn:incoming>
      <bpmn:outgoing>Flujo_UnirEnvio_Enviar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Enviar" name="Enviar la solicitud">
      <bpmn:incoming>Flujo_UnirEnvio_Enviar</bpmn:incoming>
      <bpmn:outgoing>Flujo_Enviar_Validar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Validar" name="Validar datos, fechas, vigencias y archivos">
      <bpmn:incoming>Flujo_Enviar_Validar</bpmn:incoming>
      <bpmn:outgoing>Flujo_Validar_CumpleTodo</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CumpleTodo" name="¿Cumple todo?">
      <bpmn:incoming>Flujo_Validar_CumpleTodo</bpmn:incoming>
      <bpmn:outgoing>Flujo_CumpleTodo_Registrar</bpmn:outgoing>
      <bpmn:outgoing>Flujo_CumpleTodo_LlenarSolicitud</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Registrar" name="Registrar en revisión (número y foto del checklist)">
      <bpmn:documentation>Estado «En revisión». Guarda el checklist con el que se envió: un cambio posterior del catálogo no altera la solicitud.</bpmn:documentation>
      <bpmn:incoming>Flujo_CumpleTodo_Registrar</bpmn:incoming>
      <bpmn:outgoing>Flujo_Registrar_AvisarUCVMM</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="AvisarUCVMM" name="Avisar a UCVMM por correo">
      <bpmn:incoming>Flujo_Registrar_AvisarUCVMM</bpmn:incoming>
      <bpmn:outgoing>Flujo_AvisarUCVMM_Revisar</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Revisar" name="Revisar el expediente y los documentos">
      <bpmn:incoming>Flujo_AvisarUCVMM_Revisar</bpmn:incoming>
      <bpmn:outgoing>Flujo_Revisar_Impedimentos</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Impedimentos" name="Verificar impedimentos de cada tripulante">
      <bpmn:documentation>Registrada, solo se cambia con una corrección que exige motivo.</bpmn:documentation>
      <bpmn:incoming>Flujo_Revisar_Impedimentos</bpmn:incoming>
      <bpmn:outgoing>Flujo_Impedimentos_Decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Decision" name="¿Qué decide?">
      <bpmn:incoming>Flujo_Impedimentos_Decision</bpmn:incoming>
      <bpmn:outgoing>Flujo_Decision_AvisoDevolucion</bpmn:outgoing>
      <bpmn:outgoing>Flujo_Decision_GenerarAutorizacion</bpmn:outgoing>
      <bpmn:outgoing>Flujo_Decision_Denegada</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="AvisoDevolucion" name="Aviso a la agencia: motivo y plazo">
      <bpmn:incoming>Flujo_Decision_AvisoDevolucion</bpmn:incoming>
      <bpmn:outgoing>Flujo_AvisoDevolucion_Corregir</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_AvisoDevolucion" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="Corregir" name="Corregir datos y documentos">
      <bpmn:incoming>Flujo_AvisoDevolucion_Corregir</bpmn:incoming>
      <bpmn:outgoing>Flujo_Corregir_UnirEnvio</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="VencePlazoCorreccion" name="Vence el plazo de corrección (2 días)" attachedToRef="Corregir" cancelActivity="true">
      <bpmn:documentation>PLAZO_CORRECCION_DIAS.</bpmn:documentation>
      <bpmn:outgoing>Flujo_VencePlazoCorreccion_ExpiradaSinCorregir</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_VencePlazoCorreccion"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="ExpiradaSinCorregir" name="Expirada: aviso a la agencia">
      <bpmn:incoming>Flujo_VencePlazoCorreccion_ExpiradaSinCorregir</bpmn:incoming>
      <bpmn:messageEventDefinition id="Def_ExpiradaSinCorregir" />
    </bpmn:endEvent>
    <bpmn:endEvent id="Denegada" name="Denegada: aviso a la agencia con el motivo">
      <bpmn:incoming>Flujo_Decision_Denegada</bpmn:incoming>
      <bpmn:messageEventDefinition id="Def_Denegada" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="GenerarAutorizacion" name="Generar la autorización (PDF con QR)">
      <bpmn:documentation>Estado «Aprobada», vigente hasta la fecha de la operación + DIAS_GRACIA_FINALIZACION (si ya pasó, no se aprueba: se devuelve a corrección). El PDF dice «Aprobada por: UCVMM». La observación de aprobación es interna.</bpmn:documentation>
      <bpmn:incoming>Flujo_Decision_GenerarAutorizacion</bpmn:incoming>
      <bpmn:outgoing>Flujo_GenerarAutorizacion_AvisoAprobacion</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="AvisoAprobacion" name="Aviso a la agencia y al puesto de control">
      <bpmn:incoming>Flujo_GenerarAutorizacion_AvisoAprobacion</bpmn:incoming>
      <bpmn:outgoing>Flujo_AvisoAprobacion_EnParalelo</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_AvisoAprobacion" />
    </bpmn:intermediateThrowEvent>
    <bpmn:parallelGateway id="EnParalelo">
      <bpmn:incoming>Flujo_AvisoAprobacion_EnParalelo</bpmn:incoming>
      <bpmn:outgoing>Flujo_EnParalelo_Descargar</bpmn:outgoing>
      <bpmn:outgoing>Flujo_EnParalelo_Finalizar</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Descargar" name="Descargar la autorización (PDF)">
      <bpmn:incoming>Flujo_EnParalelo_Descargar</bpmn:incoming>
      <bpmn:outgoing>Flujo_Descargar_AgenciaConAutorizacion</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="AgenciaConAutorizacion" name="Agencia con la autorización">
      <bpmn:incoming>Flujo_Descargar_AgenciaConAutorizacion</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Finalizar" name="Atender la operación y finalizar">
      <bpmn:documentation>Comentario obligatorio y puesto donde terminó la operación (por defecto, el autorizado).</bpmn:documentation>
      <bpmn:incoming>Flujo_EnParalelo_Finalizar</bpmn:incoming>
      <bpmn:outgoing>Flujo_Finalizar_Finalizada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="VenceFinalizacion" name="Vence: fecha de operación + 1 día" attachedToRef="Finalizar" cancelActivity="true">
      <bpmn:documentation>DIAS_GRACIA_FINALIZACION. Lo revisa la tarea de vencimientos cada 15 minutos.</bpmn:documentation>
      <bpmn:outgoing>Flujo_VenceFinalizacion_ExpiradaSinFinalizar</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_VenceFinalizacion" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Finalizada" name="Autorización finalizada">
      <bpmn:incoming>Flujo_Finalizar_Finalizada</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ExpiradaSinFinalizar" name="Expirada: aviso a la agencia">
      <bpmn:incoming>Flujo_VenceFinalizacion_ExpiradaSinFinalizar</bpmn:incoming>
      <bpmn:messageEventDefinition id="Def_ExpiradaSinFinalizar" />
    </bpmn:endEvent>
    <bpmn:startEvent id="ConsultaQR" name="Se consulta el código QR">
      <bpmn:outgoing>Flujo_ConsultaQR_MostrarEstado</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_ConsultaQR" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="MostrarEstado" name="Mostrar estado y vigencia (sin el expediente)">
      <bpmn:documentation>Endpoint público /verificacion/{código}, con rate limit. No abre el expediente.</bpmn:documentation>
      <bpmn:incoming>Flujo_ConsultaQR_MostrarEstado</bpmn:incoming>
      <bpmn:outgoing>Flujo_MostrarEstado_RespuestaQR</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="RespuestaQR" name="Respuesta al verificador">
      <bpmn:incoming>Flujo_MostrarEstado_RespuestaQR</bpmn:incoming>
      <bpmn:messageEventDefinition id="Def_RespuestaQR" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_Inicio_IniciarSesion" sourceRef="Inicio" targetRef="IniciarSesion" />
    <bpmn:sequenceFlow id="Flujo_IniciarSesion_LlenarSolicitud" sourceRef="IniciarSesion" targetRef="LlenarSolicitud" />
    <bpmn:sequenceFlow id="Flujo_LlenarSolicitud_AdjuntarDocumentos" sourceRef="LlenarSolicitud" targetRef="AdjuntarDocumentos" />
    <bpmn:sequenceFlow id="Flujo_AdjuntarDocumentos_UnirEnvio" sourceRef="AdjuntarDocumentos" targetRef="UnirEnvio" />
    <bpmn:sequenceFlow id="Flujo_UnirEnvio_Enviar" sourceRef="UnirEnvio" targetRef="Enviar" />
    <bpmn:sequenceFlow id="Flujo_Enviar_Validar" sourceRef="Enviar" targetRef="Validar" />
    <bpmn:sequenceFlow id="Flujo_Validar_CumpleTodo" sourceRef="Validar" targetRef="CumpleTodo" />
    <bpmn:sequenceFlow id="Flujo_Registrar_AvisarUCVMM" sourceRef="Registrar" targetRef="AvisarUCVMM" />
    <bpmn:sequenceFlow id="Flujo_AvisarUCVMM_Revisar" sourceRef="AvisarUCVMM" targetRef="Revisar" />
    <bpmn:sequenceFlow id="Flujo_Revisar_Impedimentos" sourceRef="Revisar" targetRef="Impedimentos" />
    <bpmn:sequenceFlow id="Flujo_Impedimentos_Decision" sourceRef="Impedimentos" targetRef="Decision" />
    <bpmn:sequenceFlow id="Flujo_GenerarAutorizacion_AvisoAprobacion" sourceRef="GenerarAutorizacion" targetRef="AvisoAprobacion" />
    <bpmn:sequenceFlow id="Flujo_AvisoAprobacion_EnParalelo" sourceRef="AvisoAprobacion" targetRef="EnParalelo" />
    <bpmn:sequenceFlow id="Flujo_Descargar_AgenciaConAutorizacion" sourceRef="Descargar" targetRef="AgenciaConAutorizacion" />
    <bpmn:sequenceFlow id="Flujo_Finalizar_Finalizada" sourceRef="Finalizar" targetRef="Finalizada" />
    <bpmn:sequenceFlow id="Flujo_ConsultaQR_MostrarEstado" sourceRef="ConsultaQR" targetRef="MostrarEstado" />
    <bpmn:sequenceFlow id="Flujo_MostrarEstado_RespuestaQR" sourceRef="MostrarEstado" targetRef="RespuestaQR" />
    <bpmn:sequenceFlow id="Flujo_CumpleTodo_Registrar" name="Sí" sourceRef="CumpleTodo" targetRef="Registrar" />
    <bpmn:sequenceFlow id="Flujo_CumpleTodo_LlenarSolicitud" name="No: muestra qué corregir" sourceRef="CumpleTodo" targetRef="LlenarSolicitud" />
    <bpmn:sequenceFlow id="Flujo_Decision_AvisoDevolucion" name="Devolver a corrección" sourceRef="Decision" targetRef="AvisoDevolucion" />
    <bpmn:sequenceFlow id="Flujo_AvisoDevolucion_Corregir" sourceRef="AvisoDevolucion" targetRef="Corregir" />
    <bpmn:sequenceFlow id="Flujo_Corregir_UnirEnvio" sourceRef="Corregir" targetRef="UnirEnvio" />
    <bpmn:sequenceFlow id="Flujo_VencePlazoCorreccion_ExpiradaSinCorregir" sourceRef="VencePlazoCorreccion" targetRef="ExpiradaSinCorregir" />
    <bpmn:sequenceFlow id="Flujo_Decision_GenerarAutorizacion" name="Aprobar" sourceRef="Decision" targetRef="GenerarAutorizacion" />
    <bpmn:sequenceFlow id="Flujo_Decision_Denegada" name="Denegar" sourceRef="Decision" targetRef="Denegada" />
    <bpmn:sequenceFlow id="Flujo_EnParalelo_Descargar" sourceRef="EnParalelo" targetRef="Descargar" />
    <bpmn:sequenceFlow id="Flujo_EnParalelo_Finalizar" sourceRef="EnParalelo" targetRef="Finalizar" />
    <bpmn:sequenceFlow id="Flujo_VenceFinalizacion_ExpiradaSinFinalizar" sourceRef="VenceFinalizacion" targetRef="ExpiradaSinFinalizar" />
    <bpmn:textAnnotation id="Nota_Acceso"><bpmn:text>Ver el diagrama «Acceso a ARGO NAVIS».</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_Nota_Acceso" associationDirection="None" sourceRef="Nota_Acceso" targetRef="IniciarSesion" />
    <bpmn:textAnnotation id="Nota_Checklist"><bpmn:text>El checklist depende del trámite, del rango y de la nacionalidad de cada tripulante.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_Nota_Checklist" associationDirection="None" sourceRef="Nota_Checklist" targetRef="LlenarSolicitud" />
    <bpmn:textAnnotation id="Nota_Validaciones"><bpmn:text>Operación entre hoy y 365 días · tripulantes mayores de 18 · pasaporte y seamanbook vigentes · PDF, Word o Excel revisados por su contenido y sin macros.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_Nota_Validaciones" associationDirection="None" sourceRef="Nota_Validaciones" targetRef="Validar" />
    <bpmn:textAnnotation id="Nota_Separacion"><bpmn:text>Separación de funciones: nadie revisa lo de su propia agencia ni lo que creó.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_Nota_Separacion" associationDirection="None" sourceRef="Nota_Separacion" targetRef="Revisar" />
    <bpmn:textAnnotation id="Nota_Impedimentos"><bpmn:text>Obligatoria para aprobar. Con impedimento igual se puede aprobar.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_Nota_Impedimentos" associationDirection="None" sourceRef="Nota_Impedimentos" targetRef="Impedimentos" />
    <bpmn:textAnnotation id="Nota_Custodia"><bpmn:text>Desembarque, Urgencias, Renovación y Shore Pass: si hay nacionalidad restringida, el aviso pide tramitar la custodia.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_Nota_Custodia" associationDirection="None" sourceRef="Nota_Custodia" targetRef="AvisoAprobacion" />
    <bpmn:textAnnotation id="Nota_OtroPuesto"><bpmn:text>Puede terminar en otro puesto: queda en el expediente, el PDF y la verificación.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_Nota_OtroPuesto" associationDirection="None" sourceRef="Nota_OtroPuesto" targetRef="Finalizar" />
    <bpmn:textAnnotation id="Nota_Bitacora"><bpmn:text>Cada paso queda en el historial y en la bitácora. Lo interno (impedimentos, observaciones, nombres de funcionarios) no le llega a la agencia.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="Proceso_Verificacion" name="Verificación de una autorización por QR" isExecutable="false">
    <bpmn:startEvent id="RecibeAutorizacion" name="Recibe la autorización impresa">
      <bpmn:outgoing>Flujo_RecibeAutorizacion_EscanearQR</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="EscanearQR" name="Escanear el código QR">
      <bpmn:incoming>Flujo_RecibeAutorizacion_EscanearQR</bpmn:incoming>
      <bpmn:outgoing>Flujo_EscanearQR_ConfirmarValidez</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ConfirmarValidez" name="Confirmar que la autorización es válida">
      <bpmn:incoming>Flujo_EscanearQR_ConfirmarValidez</bpmn:incoming>
      <bpmn:outgoing>Flujo_ConfirmarValidez_VerificacionHecha</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="VerificacionHecha" name="Verificación hecha">
      <bpmn:incoming>Flujo_ConfirmarValidez_VerificacionHecha</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_RecibeAutorizacion_EscanearQR" sourceRef="RecibeAutorizacion" targetRef="EscanearQR" />
    <bpmn:sequenceFlow id="Flujo_EscanearQR_ConfirmarValidez" sourceRef="EscanearQR" targetRef="ConfirmarValidez" />
    <bpmn:sequenceFlow id="Flujo_ConfirmarValidez_VerificacionHecha" sourceRef="ConfirmarValidez" targetRef="VerificacionHecha" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_Autorizacion" name="Flujo de una autorización marítima">
    <bpmndi:BPMNPlane id="Plano_Autorizacion" bpmnElement="Colaboracion_Autorizacion">
      <bpmndi:BPMNShape id="Pool_NAVIS_di" bpmnElement="Pool_NAVIS" isHorizontal="true"><dc:Bounds x="100" y="40" width="2620" height="1040" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_Agencia_di" bpmnElement="Carril_Agencia" isHorizontal="true"><dc:Bounds x="130" y="40" width="2590" height="280" /></bpmndi:BPMNShape>
