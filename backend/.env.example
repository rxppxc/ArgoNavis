# ════════════════════════════════════════════════════════════════════════════
# ARGO NAVIS (SNM) — Plantilla de variables de entorno
# Copia este archivo como `.env` y completa los valores. NO subas .env al repo.
# ════════════════════════════════════════════════════════════════════════════

# ───── Aplicación ─────
APP_NAME=ARGO NAVIS - SNM
# development | staging | production
# Importante: en `production` se ocultan /api/docs y se restringe CORS.
APP_ENV=development

# ───── Logs ─────
# Además de la consola, un archivo por día en esta carpeta (argonavis-AAAA-MM-DD.log),
# que se borra a los LOG_DIAS días. Relativa a backend\ (donde arrancan los .bat).
# Recomendado en Windows, donde la consola no queda guardada. Vacío = solo consola.
LOG_CARPETA=
LOG_DIAS=30
# DEBUG | INFO | WARNING | ERROR
LOG_NIVEL=INFO

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotar al menos cada 90 días. Cambiar invalida todas las sesiones activas.
# En producción el backend no arranca con menos de 32 caracteres ni con este valor.
SECRET_KEY=REEMPLAZAR_CON_CLAVE_GENERADA

# Duración del token (recomendado 60-480 minutos). El frontend lo renueva
# mientras el usuario trabaja, hasta SESION_MAXIMA_HORAS desde el login.
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESION_MAXIMA_HORAS=12
ALGORITHM=HS256

# ───── Base de datos ─────
# Producción: usar usuario dedicado con permisos mínimos (no `postgres`)
# Ajusta el nombre de la BD si tu instancia usa otro nombre.
DATABASE_URL=postgresql+asyncpg://USUARIO:PASSWORD@HOST:5432/argonavis
# Recomendado: la aplicación con su propia cuenta (DATABASE_URL, p. ej. argonavis_app)
# y las migraciones con la dueña de las tablas. migrate.bat migra con esta y después
# crea o pone al día la de la aplicación, con lo justo (bitácora solo para agregar).
# Vacía = todo con DATABASE_URL.
MIGRACIONES_DATABASE_URL=
# Conexiones POR PROCESO: con los 4 workers de start-backend-prod.bat, hasta
# 4 × (BD_POOL + BD_POOL_EXTRA) = 60. Tiene que quedar por debajo de
# max_connections de PostgreSQL (100 por defecto).
BD_POOL=5
BD_POOL_EXTRA=10
# Segundos que una petición espera una conexión libre antes de responder 503.
BD_POOL_ESPERA=10
# Topes en segundos (0 = sin tope): una consulta, y una transacción abierta sin
# actividad. Liberan la conexión y los bloqueos de fila de una petición colgada.
BD_TIEMPO_MAXIMO_CONSULTA=60
BD_TIEMPO_MAXIMO_INACTIVA=300

# ───── LDAP / Active Directory ─────
LDAP_HOST=192.168.X.X
LDAP_PORT=389
LDAP_BASE_DN=DC=ejemplo,DC=local
LDAP_BIND_USER=cuenta-servicio@ejemplo.local
LDAP_BIND_PASSWORD=REEMPLAZAR
LDAP_TIMEOUT=10
# Restringe login a una OU. Vacío = todo el dominio.
LDAP_ALLOWED_OU=
# TLS con el AD (recomendado: sin TLS la contraseña de cada login viaja en claro).
# LDAPS: LDAP_USAR_SSL=true y LDAP_PORT=636 · StartTLS: LDAP_STARTTLS=true (389).
# LDAP_HOST debe ser el nombre del certificado del AD (no la IP); LDAP_CA_CERT,
# la ruta al PEM de la CA interna (vacío = CA del sistema).
LDAP_USAR_SSL=false
LDAP_STARTTLS=false
LDAP_CA_CERT=

# ───── Documentos de los expedientes ─────
# Una carpeta por solicitud (solicitud-{id}) dentro de esta raíz.
STORAGE_PATH=./storage/documentos
# El tope por archivo (2 MB, cualquier formato) es fijo, en el código:
# TAMANO_MAXIMO_MB en app/infrastructure/almacenamiento.py. También el de un envío
# entero (TOPE_CUERPO_ENVIO_MB, 283 MB) y el del resto de la API (1 MB).
# Con menos espacio libre que esto (MB) en el disco de los documentos, no se
# reciben archivos (507): que las subidas no llenen el disco de la base. 0 = sin control.
ESPACIO_MINIMO_LIBRE_MB=1024

# ───── SMTP ─────
MAIL_HOST=correo.ejemplo.local
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ejemplo.local
MAIL_FROM_NAME=ARGO NAVIS - SNM
# TLS con el servidor de correo (con usuario y contraseña, recomendado: sin TLS
# viajan en claro). STARTTLS: MAIL_STARTTLS=true (587 o 25) · SMTPS:
# MAIL_USAR_SSL=true y MAIL_PORT=465. MAIL_HOST debe ser el nombre del
# certificado (no la IP); MAIL_CA_CERT, la ruta al PEM de la CA interna (vacío =
# CA del sistema). Apagado, como siempre: ni siquiera se intenta STARTTLS.
MAIL_STARTTLS=false
MAIL_USAR_SSL=false
MAIL_CA_CERT=
# Segundos de espera por el servidor de correo en cada envío: mientras espera,
# el envío retiene una conexión de la BD. Lo que falla se reintenta (cola).
MAIL_TIEMPO_ESPERA=20

# ───── Autorizaciones Marítimas ─────
# Buzón de UCVMM: recibe el aviso de cada solicitud nueva o corregida. Vacío = sin aviso.
CORREO_UCVMM=autorizacionmaritima@migracion.gob.pa
# Días que tiene la agencia para corregir una solicitud devuelta (luego expira): 3 = 72 h.
PLAZO_CORRECCION_DIAS=3
# Días después de la fecha de la operación para que el puesto de control
# finalice una autorización aprobada (vence a las 23:59 del último; luego expira):
# 2 = 72 h desde que empieza el día de la operación.
DIAS_GRACIA_FINALIZACION=2
# Anticipación máxima de la fecha de la operación (días desde hoy).
DIAS_MAXIMOS_ANTICIPACION=365
# Cada cuántos minutos se revisan los plazos vencidos.
VENCIMIENTOS_INTERVALO_MINUTOS=15

# ───── CORS / URLs ─────
# Origen del frontend (dev usa Vite en :5173)
FRONTEND_URL=http://localhost:5173
# URL pública incluida en los correos
APP_URL=http://localhost:5173

# ───── Rate limiting ─────
# Consultas por IP por minuto a la verificación pública del QR. 0 desactiva el límite.
LIMITE_VERIFICACIONES_POR_MINUTO=30
# Solicitudes que una misma cuenta puede crear o corregir por hora (cada una
# sube archivos): frena a una cuenta comprometida que quiera llenar el disco.
# 0 desactiva el límite.
LIMITE_ENVIOS_POR_HORA=30
# Exportaciones de las estadísticas y descargas del PDF de una autorización, por
# cuenta y por hora: cada una ocupa la CPU unos cientos de milisegundos. Frenan un
# ciclo o un script, no el uso normal. 0 desactiva el límite.
LIMITE_EXPORTACIONES_POR_HORA=30
LIMITE_PDF_POR_HORA=120
# Cuántos de esos archivos arma cada proceso a la vez; los demás esperan su turno.
TRABAJOS_PESADOS_A_LA_VEZ=2

# ───── Cuentas locales (sin AD) ─────
# Habilita las cuentas con contraseña propia creadas desde /admin (p. ej. para
# los usuarios de las agencias navieras). Independiente de APP_ENV.
PERMITIR_LOGIN_LOCAL=false
# Bloqueo temporal tras varios intentos fallidos seguidos.
LOGIN_MAX_INTENTOS=5
LOGIN_MINUTOS_BLOQUEO=15

# ───── Freno del login del Active Directory ─────
# Tras LOGIN_AD_MAX_FALLOS fallos seguidos con una cuenta del AD, ARGO NAVIS deja de
# consultar al AD por ella durante LOGIN_AD_MINUTOS_ESPERA. Ajustar a la política
# de bloqueo de cuentas del dominio (pedírsela a TI), para que nadie, p. ej. desde
# la VPN de las agencias, le bloquee la cuenta del dominio a un funcionario:
#   - LOGIN_AD_MAX_FALLOS por debajo del "Umbral de bloqueo de cuenta", con margen
#     para los errores del propio usuario en su PC;
#   - LOGIN_AD_MINUTOS_ESPERA mayor o igual que "Restablecer el contador de
#     bloqueos de cuenta después de".
LOGIN_AD_MAX_FALLOS=3
LOGIN_AD_MINUTOS_ESPERA=30
